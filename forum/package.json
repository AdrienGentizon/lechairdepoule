{
  "name": "forum",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier . --check",
    "format:write": "prettier . --write",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "better-auth:generate-secret": "openssl rand -base64 32",
    "better-auth:db:generate": "pnpm dlx auth@latest generate",
    "better-auth:db:migrate": "pnpm dlx auth@latest migrate"
  },
  "dependencies": {
    "better-auth": "1.6.11",
    "clsx": "^2.1.1",
    "next": "16.2.7",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
