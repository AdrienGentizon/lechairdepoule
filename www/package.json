{
  "name": "www",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write --log-level warn .",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:dump": "set -a && source .env.local && set +a && pg_dump -Fc -d \"$PG_BACKUP_FROM_CONNECTION_STRING\" -f ../backup.dump",
    "db:restore": "set -a && source .env.local && set +a && pg_restore --no-owner --no-privileges --clean --if-exists -d \"$PG_RESTORE_TO_CONNECTION_STRING\" ../backup.dump"
  },
  "dependencies": {
    "@cdp/ui": "workspace:*",
    "@clerk/backend": "^2.33.7",
    "@clerk/nextjs": "^6.39.7",
    "@clerk/themes": "^2.4.57",
    "@contentful/rich-text-react-renderer": "^16.2.2",
    "@contentful/rich-text-types": "^17.2.7",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/nextjs": "^10.75.3",
    "@tanstack/react-query": "^5.103.2",
    "@vercel/analytics": "^1.6.1",
    "@vercel/blob": "^2.8.0",
    "@webscopeio/react-textarea-autocomplete": "^4.9.2",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "contentful": "^11.12.10",
    "input-otp": "^1.5.0",
    "lucide-react": "^0.473.0",
    "next": "catalog:",
    "nuqs": "^2.10.1",
    "postgres": "catalog:",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^4.8.0",
    "tailwind-merge": "catalog:",
    "uuid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/webscopeio__react-textarea-autocomplete": "^4.7.5",
    "eslint-config-next": "catalog:",
    "postcss": "^8.5.28",
    "tailwindcss": "catalog:"
  }
}
